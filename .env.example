# MongoDB
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGO_DB=IN_OUTX
SECRET_KEY=replace_with_a_long_random_secret

# Authorized college email domains
COLLEGE_EMAIL_DOMAINS=krct.ac.in,krce.ac.in

# SMTP used to send college email verification codes.
# For Gmail, use an App Password for MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-college-email
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-college-email
